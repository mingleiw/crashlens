{
  "name": "@mingleiw/crashlens",
  "version": "0.1.0",
  "description": "Turn a Linux core dump into a readable bug report: where it died and why, with evidence. Never runs your program.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crashlens": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:site": "npm run build && node site/build.mjs && node site/check.mjs",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "peerDependencies": {
    "rea-agents": ">=6.4.0"
  },
  "peerDependenciesMeta": {
    "rea-agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingleiw/crashlens.git"
  },
  "homepage": "https://github.com/mingleiw/crashlens#readme",
  "bugs": {
    "url": "https://github.com/mingleiw/crashlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "crash",
    "core-dump",
    "debugging",
    "triage",
    "gdb",
    "reverse-engineering",
    "rea"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0"
  }
}
